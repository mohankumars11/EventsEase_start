# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.env.example

# Editor / OS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Local Claude Code tooling
.claude/
.vercel
.env*

# Pre-deletion catalogue dumps from scripts/export-shop-catalogue.mjs.
# These hold order rows, which carry customer addresses — never commit them.
backup/

# Local demo session for scripts/demo-scenario.mjs — a real auth token.
.demo-session.json
.demo-partner-session.json
.demo-admin-session.json

# Generated per build target by scripts/capacitor-config.mjs.
# Committing one would ship the partner app under the customer's id.
capacitor.config.json

# Android signing keys. NEVER commit these.
# Losing the release keystore means the app can never be updated on
# Play Store again — not fixed, not recovered. New package name, new
# listing, every install lost. Back it up somewhere off this machine.
*.jks
*.keystore
keystore.properties
google-services.json
!android/app/google-services.json
!android/app/src/*/google-services.json

# ── Service-account keys ─────────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT is a real credential: it can send a push to
# every device registered to this project. It lives in .env (ignored
# above) and in Vercel's encrypted store, and nowhere else. These
# patterns catch the JSON file Google hands you on download, whatever
# you happened to name it.
*firebase-adminsdk*.json
*service-account*.json
serviceAccountKey.json

# ── Apple signing ────────────────────────────────────────────────────
# The iOS equivalent of the Android keystore above. An .p8 is an APNs
# key that can push to every install; a .p12 plus a provisioning profile
# is enough to sign an app as you.
*.p8
*.p12
*.mobileprovision
*.cer
ios/App/App/GoogleService-Info.plist

# ── Anything a script writes that holds a live token ─────────────────
# The demo session files above are the known ones. This catches the
# next one before it is committed rather than after.
*-session.json
.demo-*.json
