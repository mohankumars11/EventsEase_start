# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/

# Environment variables (never commit real secrets)
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.env.example

# Editor / OS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Local Claude Code tooling
.claude/
.vercel
.env*

# Pre-deletion catalogue dumps from scripts/export-shop-catalogue.mjs.
# These hold order rows, which carry customer addresses — never commit them.
backup/

# Local demo session for scripts/demo-scenario.mjs — a real auth token.
.demo-session.json
.demo-partner-session.json
.demo-admin-session.json

# Generated per build target by scripts/capacitor-config.mjs.
# Committing one would ship the partner app under the customer's id.
capacitor.config.json

# Android signing keys. NEVER commit these.
# Losing the release keystore means the app can never be updated on
# Play Store again — not fixed, not recovered. New package name, new
# listing, every install lost. Back it up somewhere off this machine.
*.jks
*.keystore
keystore.properties
google-services.json
!android/app/google-services.json
!android/app/src/*/google-services.json

# ── Service-account keys ─────────────────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT is a real credential: it can send a push to
# every device registered to this project. It lives in .env (ignored
# above) and in Vercel's encrypted store, and nowhere else. These
# patterns catch the JSON file Google hands you on download, whatever
# you happened to name it.
*firebase-adminsdk*.json
*service-account*.json
serviceAccountKey.json

# ── Apple signing ────────────────────────────────────────────────────
# The iOS equivalent of the Android keystore above. An .p8 is an APNs
# key that can push to every install; a .p12 plus a provisioning profile
# is enough to sign an app as you.
*.p8
*.p12
*.mobileprovision
*.cer
ios/App/App/GoogleService-Info.plist

# ── Anything a script writes that holds a live token ─────────────────
# The demo session files above are the known ones. This catches the
# next one before it is committed rather than after.
*-session.json
.demo-*.json

# ── Android build products ───────────────────────────────────────────
# The Capacitor project itself IS committed — CI needs it to build the
# APK, and it was its absence that made every workflow run fail. What is
# not committed is anything Gradle generates or anything machine-local.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/.idea/
android/app/release/

# ── One deliberate exception ─────────────────────────────────────────
# `.env*` is ignored above, and it must stay that way: .env holds the
# service role key, the Firebase service account and the Razorpay
# secret.
#
# .env.android is the opposite kind of file. Every value in it is
# already public in the browser bundle served from sambramoh.vercel.app
# -- the Supabase ANON key and the Firebase WEB config -- and the APK
# build needs them at compile time. The file itself explains the rule at
# length, and the rule is: if it is already in the browser it may be
# there, if it is not it may not.
#
# Negated explicitly rather than force-added, so the exception is
# visible to anyone reading this file instead of hidden in a git
# command somebody ran once.
!.env.android

# Raw Nominatim responses cached by scripts/activate-pincodes.mjs.
# Regenerable working state, not repo content — the coordinates that
# matter live in the `pincodes` table.
scripts/data/pincode-geocode-cache.json
