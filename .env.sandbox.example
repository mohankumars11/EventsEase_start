# A throwaway environment. See docs/SANDBOX.md.
#
# Copy to .env.sandbox and fill in from the sandbox Supabase project.
# This database holds nothing real, so the only rule that matters is the
# one about Razorpay: TEST keys only, never the live pair.

# true is correct here -- the seeded network is the point
ALLOW_SYNTHETIC_DISPATCH=
# TEST key only. Never the live one in here.
RAZORPAY_KEY_ID=
# TEST secret only.
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# sandbox service_role key -- never commit this
SUPABASE_SERVICE_ROLE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=
# sandbox anon key
VITE_SUPABASE_ANON_KEY=
# the SANDBOX project url, not production
VITE_SUPABASE_URL=
VITE_UNSPLASH_ACCESS_KEY=
VITE_UPI_ID=
VITE_UPI_PAYEE_NAME=
