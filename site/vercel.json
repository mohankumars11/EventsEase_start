{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/app",
      "destination": "https://sambramoh.vercel.app/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://sambramoh.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://sambramoh.vercel.app/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://sambramoh.vercel.app/signup",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://sambramoh.vercel.app/dashboard/:path*",
      "permanent": false
    },
    {
      "source": "/track/:path*",
      "destination": "https://sambramoh.vercel.app/track/:path*",
      "permanent": false
    },
    {
      "source": "/partner-app",
      "destination": "https://sambramo-partners.vercel.app/",
      "permanent": false
    },
    {
      "source": "/partner-app/:path*",
      "destination": "https://sambramo-partners.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/cities",
      "destination": "/bengaluru/",
      "permanent": true
    },
    {
      "source": "/cities/bengaluru",
      "destination": "/bengaluru/",
      "permanent": true
    },
    {
      "source": "/bangalore",
      "destination": "/bengaluru/",
      "permanent": true
    },
    {
      "source": "/for-partners",
      "destination": "/partners/",
      "permanent": true
    },
    {
      "source": "/for-partners/:path*",
      "destination": "/partners/:path*",
      "permanent": true
    },
    {
      "source": "/occasions/griha-pravesh",
      "destination": "/occasions/housewarming/",
      "permanent": true
    },
    {
      "source": "/occasions/upanayanam",
      "destination": "/occasions/thread-ceremony/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/what-it-costs/",
      "permanent": true
    },
    {
      "source": "/vendors",
      "destination": "/partners/",
      "permanent": true
    },
    {
      "source": "/join",
      "destination": "/partners/join/",
      "permanent": true
    },
    {
      "source": "/app/",
      "destination": "https://sambramoh.vercel.app/",
      "permanent": false
    },
    {
      "source": "/partner-app/",
      "destination": "https://sambramo-partners.vercel.app/",
      "permanent": false
    },
    {
      "source": "/login/",
      "destination": "https://sambramoh.vercel.app/login",
      "permanent": false
    },
    {
      "source": "/signup/",
      "destination": "https://sambramoh.vercel.app/signup",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
